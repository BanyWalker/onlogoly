# Copy values into your shell/IDE environment; Spring does not load .env files.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

XIYUAN_STORAGE_BACKEND=json
XIYUAN_WORKSPACE_ID=ENV-OM-001
XIYUAN_DATA_DIR=../workspace-data

# Activate postgres only after configuring a development database.
# SPRING_PROFILES_ACTIVE=postgres,oidc
DB_URL=jdbc:postgresql://127.0.0.1:5432/xiyuan_ontology
DB_USERNAME=replace_me
DB_PASSWORD=replace_me

# A real OIDC provider must validate issuer and intended audience.
OIDC_ISSUER_URI=https://identity.example.invalid/realms/xiyuan
OIDC_AUDIENCE=xiyuan-ontology-api
